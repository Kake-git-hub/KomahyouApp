rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(workspaceKey) {
      return /databases/$(database)/documents/workspaces/$(workspaceKey)/members/$(request.auth.uid);
    }

    function hasWorkspaceMembership(workspaceKey) {
      return isSignedIn() && exists(memberDoc(workspaceKey));
    }

    function workspaceRole(workspaceKey) {
      return get(memberDoc(workspaceKey)).data.role;
    }

    function assignedClassroomId(workspaceKey) {
      return get(memberDoc(workspaceKey)).data.assignedClassroomId;
    }

    function isDeveloper(workspaceKey) {
      return hasWorkspaceMembership(workspaceKey) && workspaceRole(workspaceKey) == 'developer';
    }

    // 請求の許可者(P-11 ④ 第 1 段・2026-10-10・docs/spec-multi-tenant.md §7-11): developer かつ
    // (会員文書の billingAllowed フラグ **または** 従来のメール固定)。第 2 段(メール固定の撤去)は、オーナーが
    // 各 workspace の自分の会員文書に billingAllowed:true を立ててから(片方だけの状態を作らない)。
    // クライアント側の同じ判定は src/utils/companyBilling.ts isBillingAllowedUser(片方だけ変えない)。
    function isBillingDeveloper(workspaceKey) {
      return isDeveloper(workspaceKey)
        && (
          get(memberDoc(workspaceKey)).data.get('billingAllowed', false) == true
          || get(memberDoc(workspaceKey)).data.email == 'dai.in.the.mood@gmail.com'
          || get(memberDoc(workspaceKey)).data.email == 'bkkdmzn@gmail.com'
          || get(memberDoc(workspaceKey)).data.email == 'd.ishikawa@agc-akasaka.com'
          || request.auth.token.email == 'dai.in.the.mood@gmail.com'
          || request.auth.token.email == 'bkkdmzn@gmail.com'
          || request.auth.token.email == 'd.ishikawa@agc-akasaka.com'
        );
    }

    // members の create/update で billingAllowed が変わらない(無い = false 扱い)。
    function billingAllowedUnchanged() {
      return request.resource.data.get('billingAllowed', false)
        == (resource == null ? false : resource.data.get('billingAllowed', false));
    }

    function canAccessClassroom(workspaceKey, classroomId) {
      return hasWorkspaceMembership(workspaceKey)
        && (
          workspaceRole(workspaceKey) == 'developer'
          || assignedClassroomId(workspaceKey) == classroomId
        );
    }

    match /workspaces/{workspaceKey} {
      allow read: if hasWorkspaceMembership(workspaceKey);
      allow write: if isDeveloper(workspaceKey);

      match /members/{userId} {
        allow read: if isDeveloper(workspaceKey) || (hasWorkspaceMembership(workspaceKey) && request.auth.uid == userId);
        // 請求許可フラグ billingAllowed(P-11 ④)を変えられるのは請求許可者だけ(レビュー所見 2026-10-10)。
        // developer なら誰でも members を書けるので、ここを塞がないと許可外の developer が自分に true を書いて
        // billingMonths / 台帳を読めるようになる(メール固定が担っていた「developer の中でも請求は特定の人」が外れる)。
        allow create, update: if isDeveloper(workspaceKey)
          && (isBillingDeveloper(workspaceKey) || billingAllowedUnchanged());
        allow delete: if isDeveloper(workspaceKey);
      }

      match /classrooms/{classroomId} {
        allow read: if canAccessClassroom(workspaceKey, classroomId);
        allow write: if isDeveloper(workspaceKey);
      }

      // A3: 教室スナップショット/設定の保存は Cloud Function(saveClassroomSnapshot)へ一本化済み。
      // 通常保存は Admin SDK でルールを迂回するため、クライアント直書き(create/update)は
      // 「保存の裏口」(版数照合・空データ拒否・読み戻し検証を素通り)になる。
      // マネージャーは直書きしない(CF経由)ので、直書きは開発者のみに限定する。
      // 読み取りは従来通り(教室アクセス権)に保つ。delete は従来通り開発者のみ。
      match /classroomSnapshots/{classroomId} {
        allow read: if canAccessClassroom(workspaceKey, classroomId);
        // 開発者の教室作成(provisionFirebaseWorkspaceClassroomWithExistingUid)で初期スナップショットを直書きする。
        allow create, update: if isDeveloper(workspaceKey);
        allow delete: if isDeveloper(workspaceKey);

        // chunks/parts/boardWeeks は旧「分割保存」の名残。現在クライアントから書く経路は無い。
        // 古い分割データの読み取りだけ残し、書き込みは開発者のみに閉じる。
        match /chunks/{chunkId} {
          allow read: if canAccessClassroom(workspaceKey, classroomId);
          allow create, update, delete: if isDeveloper(workspaceKey);
        }

        match /parts/{partId} {
          allow read: if canAccessClassroom(workspaceKey, classroomId);
          allow create, update, delete: if isDeveloper(workspaceKey);
        }

        match /boardWeeks/{weekId} {
          allow read: if canAccessClassroom(workspaceKey, classroomId);
          allow create, update, delete: if isDeveloper(workspaceKey);
        }

        // 保護者向け固定QR(docs/spec-parent-portal.md §E-2・2026-09-13): 保護者からの連絡。
        // 書くのは Cloud Function parentPortalApi(POST)と markParentMessagesNotified(既読化)だけ。
        // 教室メンバー(室長)は自教室ぶんを購読して通知モーダルに出す。write:false を緩めない
        // (クライアントから既読を書けるようにすると「端末ごとの既読」に戻り、他端末で再通知される)。
        match /parentMessages/{messageId} {
          allow read: if canAccessClassroom(workspaceKey, classroomId);
          allow write: if false;
        }

        // 同 §E-1: 保護者連絡の回数制限カウンタ。Cloud Function のトランザクション専用。クライアントは読めない。
        match /parentPortalRateLimits/{limitKey} {
          allow read, write: if false;
        }

        // 「質問・要望」への回答(docs/spec-developer-report.md §G-5・2026-09-28): 室長の端末が読む軽量文書(質問文＋回答＋既読)。
        // 書くのは Cloud Function(submitDeveloperReport=回答待ち作成 / answerDeveloperReport=回答 / markReportAnswersRead=既読)だけ。
        // 教室メンバー(室長)は自教室ぶんを購読してボタンの未読件数と履歴に出す。write:false を緩めない
        // (クライアントから既読を書けるようにすると「端末ごとの既読」に戻り、他端末で未読が残る)。
        match /reportAnswers/{reportId} {
          allow read: if canAccessClassroom(workspaceKey, classroomId);
          allow write: if false;
        }
      }

      // classroomSettings は現在クライアントから書く経路が無い(読み取りのみの旧フォールバック)。
      // 念のため読み取りは残し、書き込みは開発者のみに閉じる。
      match /classroomSettings/{classroomId} {
        allow read: if canAccessClassroom(workspaceKey, classroomId);
        allow create, update: if isDeveloper(workspaceKey);
        allow delete: if isDeveloper(workspaceKey);
      }

      match /workspaceAutoBackupSummaries/{backupDateKey} {
        allow read: if hasWorkspaceMembership(workspaceKey);
        allow write: if false;
      }

      // 「開発者へ報告」(2026-09-04): Cloud Function submitDeveloperReport だけが書く。開発者は一覧・閲覧可。
      match /developerReports/{reportId} {
        allow read: if isDeveloper(workspaceKey);
        allow write: if false;
      }

      match /billingMonths/{monthKey} {
        allow read, write: if isBillingDeveloper(workspaceKey);

        match /classrooms/{classroomId} {
          allow read, write: if isBillingDeveloper(workspaceKey);
        }
      }

      // 毎月15日 0:00(JST)時点の在籍生徒数の恒久記録(台帳)。請求の根拠になる記録なので、
      // 書き込みは Cloud Function(recordMonthlyStudentCounts / triggerMonthlyStudentCountRecord)の
      // Admin SDK からのみ。クライアントは読み取り専用にして、画面操作で記録が動かないようにする。
      // write: false を「便利だから」と緩めないこと(恒久記録が上書きされる回帰になる)。
      match /studentCountLedger/{snapshotDate} {
        allow read: if isBillingDeveloper(workspaceKey);
        allow write: if false;

        match /classrooms/{classroomId} {
          allow read: if isBillingDeveloper(workspaceKey);
          allow write: if false;
        }
      }
    }

    match /boardShares/{token} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Lecture submissions: admin creates/deletes, Cloud Functions handle public access
    match /lectureSubmissions/{token} {
      allow read, write: if isSignedIn();
    }

    // 保護者向け固定QR(docs/spec-parent-portal.md §B-1): トークンの権威と「生徒 1 名＝有効トークン 1 本」の索引。
    // 読み書きは Cloud Functions(issueStudentPortalToken / revokeStudentPortalToken / parentPortalApi)の
    // Admin SDK のみ。開発者でもクライアントからは読めない(boardShares のような公開 read 文書を作らない・§J-2)。
    // ※lectureSubmissions の isSignedIn() を写さないこと(あちらは既存仕様・無改変)。
    match /studentPortalTokens/{token} {
      allow read, write: if false;
    }

    match /studentPortalTokenOwners/{ownerId} {
      allow read, write: if false;
    }
  }
}