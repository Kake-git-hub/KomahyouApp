REPORT_MAIL_SMTP_URL=
REPORT_MAIL_TO=
REPORT_MAIL_FROM=
# 保護者向け固定QR(docs/spec-parent-portal.md §E-2)。未設定なら連絡 365 日・回数制限カウンタ 7 日(下限 30 / 1)。
PARENT_MESSAGE_RETENTION_DAYS=
PARENT_PORTAL_RATE_LIMIT_RETENTION_DAYS=
