FUNCTION_REGION=asia-northeast1
STORAGE_BUCKET=
WORKSPACE_AUTO_BACKUP_SCHEDULE=10 2 * * *
WORKSPACE_HOURLY_AUTO_BACKUP_SCHEDULE=10 * * * *
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
# 「要望・報告」のメール即時通知(2026-09-04)。未設定なら送らない(GitHub Issue 起票のみ)。
# SMTP URL 例(Gmail・アプリパスワード): smtps://you%40gmail.com:xxxx-xxxx-xxxx-xxxx@smtp.gmail.com:465 (@ は %40)
REPORT_MAIL_SMTP_URL=
REPORT_MAIL_TO=
REPORT_MAIL_FROM=
# 保護者向け固定QR(docs/spec-parent-portal.md §E-2)。未設定なら連絡 365 日・回数制限カウンタ 7 日(下限 30 / 1)。
PARENT_MESSAGE_RETENTION_DAYS=
PARENT_PORTAL_RATE_LIMIT_RETENTION_DAYS=
# 15 分毎の自動バックアップを書く形式(docs/spec-save-restore.md §10-7・2026-10-29)。未設定/legacy=全教室 1 本の非圧縮 JSON(旧形式)、
# per-classroom-v1=教室ごとの gzip＋時点の目次。会社ごとの指定は WORKSPACE_AUTO_BACKUP_LAYOUT_OVERRIDES=main=per-classroom-v1,demo=legacy。
# 読むのは設定に関係なく両形式。legacy に戻せば次の回から旧形式で書く(戻せる)。
WORKSPACE_AUTO_BACKUP_LAYOUT=
WORKSPACE_AUTO_BACKUP_LAYOUT_OVERRIDES=
# 教室別形式の取り残し(要約の無い時点フォルダ)の掃除。未設定/1=空実行(件数だけログ)・0=削除する(実物の件数を確かめてから)。
WORKSPACE_BACKUP_ORPHAN_PRUNE_DRY_RUN=
